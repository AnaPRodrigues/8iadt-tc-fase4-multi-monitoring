# Modelo de configuração de ambiente (AD-034). Copie para .env.local ou .env.cloud.
# .env.local e .env.cloud são gitignored; só este exemplo é versionado.

# Ambiente: "local" (LocalStack) ou "cloud" (AWS Learner Lab).
ENV=local

# Região (Learner Lab: sempre us-east-1, AD-007).
AWS_REGION=us-east-1

# --- Perfil local (LocalStack) ---
# Credenciais dummy; o factory injeta endpoint_url só quando ENV=local.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566

# --- Perfil cloud (AWS Learner Lab) ---
# NÃO comitar credenciais reais. No cloud, as credenciais temporárias do lab
# vêm do ambiente/CLI; deixe as três linhas abaixo vazias no .env.cloud e use
# o profile/variáveis da sessão do lab.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Role fixa do Learner Lab (não é possível criar roles, AD-007).
LAB_ROLE_ARN=

# Recursos provisionados pela IaC (mesmos nomes nos dois ambientes).
S3_BUCKET=mm-landing
SNS_TOPIC=mm-alerts
DYNAMODB_TABLE=mm-prescriptions
