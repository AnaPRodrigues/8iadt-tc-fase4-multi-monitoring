# Modelo de configuração de ambiente. Copie para .env.local ou .env.cloud.
# .env.local e .env.cloud não entram no Git; só este exemplo é versionado.

# Ambiente: "local" (simulador LocalStack) ou "cloud" (AWS de verdade).
ENV=local

# Região da AWS usada quando ENV=cloud.
AWS_REGION=us-east-1

# --- Perfil local (simulador LocalStack) ---
# Credenciais fictícias -- só servem para o simulador aceitar a conexão.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566

# --- Perfil cloud (AWS de verdade) ---
# NÃO coloque credenciais reais aqui. No ambiente de nuvem de verdade, as
# credenciais temporárias vêm do ambiente/CLI já configurado; deixe as três
# linhas abaixo vazias no seu .env.cloud e use o perfil/variáveis da sua
# sessão AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Papel (role) do IAM usado pelas funções de nuvem.
LAB_ROLE_ARN=

# Nomes dos recursos de nuvem (os mesmos nos dois ambientes).
S3_BUCKET=mm-landing
SNS_TOPIC=mm-alerts
DYNAMODB_TABLE=mm-prescriptions

# Função de nuvem da análise de prescrições -- make infra-prescription-local/cloud.
PRESCRIPTION_LAMBDA_NAME=mm-prescription-processor

# Função de nuvem complementar da análise de vídeo -- make infra-video-local/cloud.
VIDEO_LAMBDA_NAME=mm-video-analyzer
